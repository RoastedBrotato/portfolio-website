# Reviews and blog-post feedback storage — Upstash Redis
# (https://console.upstash.com). Create a database, then copy these two values
# from its REST API section. On Netlify these go in Site settings →
# Environment variables.
#
# One database serves both: the feedback inbox is a separate key prefix, not a
# separate service. Nothing extra to configure for it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The password for /admin/reviews. Any long random string —
# e.g. `openssl rand -hex 32`. Never commit the real value.
REVIEWS_ADMIN_TOKEN=

# Quote request notifications — Resend (https://resend.com). Submissions are
# stored in the Upstash database above either way and show on /admin/reviews;
# this is the email that tells you one arrived. Reply-To is set to the client.
#
# QUOTE_FROM_EMAIL must be on a domain verified in Resend (add the DNS records
# it gives you for alsufun.com), e.g. "Website <quotes@alsufun.com>".
# QUOTE_NOTIFY_EMAIL is where notifications go; defaults to the site email.
RESEND_API_KEY=
QUOTE_FROM_EMAIL=
QUOTE_NOTIFY_EMAIL=

# Cal.com or Calendly link for every "Book a call" button. Empty hides them.
NEXT_PUBLIC_BOOKING_URL=

# Plausible analytics — the per-site script URL from Site settings → Site
# installation, e.g. https://plausible.io/js/pa-XXXXXXXX.js. Unset loads nothing.
# Add these as custom-event goals in the dashboard to see them reported:
# pricing_view, quote_start, quote_submit, booking_click, social_click
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=
