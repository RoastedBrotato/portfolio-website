# Reviews storage — Upstash Redis (https://console.upstash.com).
# Create a database, then copy these two values from its REST API section.
# On Netlify these go in Site settings → Environment variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The password for /admin/reviews. Any long random string —
# e.g. `openssl rand -hex 32`. Never commit the real value.
REVIEWS_ADMIN_TOKEN=
